# Template only. Copy to `.env` (git-ignored) and fill in locally.
# NEVER commit real values. This file lists variable NAMES with empty values.
#
# Configs reference these by name (e.g. `api_key_env: ANTHROPIC_API_KEY`);
# no config, manifest, log, or run metadata ever stores a value (CLAUDE.md §7).

# Model provider credentials (needed only at the inference stage, not yet).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Dataset access (needed only for gated sources).
HF_TOKEN=

